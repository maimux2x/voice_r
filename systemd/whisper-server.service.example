# Install: mkdir -p ~/.config/systemd/user && cp this file to
#   ~/.config/systemd/user/whisper-server.service
# then: systemctl --user daemon-reload && systemctl --user enable --now whisper-server
#
# Paths below assume whisper.cpp was built under ~/src/whisper.cpp as in README.md.
# Adjust %h substitutions or hardcode paths for your machine.
[Unit]
Description=whisper.cpp transcription server (used by voice_r)
After=default.target

[Service]
Type=simple
# -t is thread count; systemd ExecStart does not expand $(nproc), so hardcode a value for this machine.
ExecStart=%h/src/whisper.cpp/build/bin/whisper-server -m %h/src/whisper.cpp/models/ggml-medium.bin --host 127.0.0.1 --port 8081 -t 8
Restart=on-failure

[Install]
WantedBy=default.target
